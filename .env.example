# ===============================================================
# Hedera Token Onboarding Kit — configuration reference
#
# This root file documents EVERY variable the template reads and
# where each one lives. Copy the relevant block into the per-package
# file shown in its header. Never commit a real .env — see .gitignore.
#
# The first journey (/ and /diagnose) needs NONE of these. You only
# need credentials to run /acquire or to deploy contracts.
# ===============================================================


# ---------------------------------------------------------------
# packages/hardhat/.env    — contract deploy + verify
# ---------------------------------------------------------------

# JSON-RPC endpoint. Testnet by default. Chain id 296.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Deployer key, ENCRYPTED AT REST. Do not paste a raw key here.
#
#   yarn hardhat:account:import     # paste key once, choose a password
#   yarn hardhat:account            # show the derived address
#
# The account MUST be ECDSA, not ED25519 — ED25519 has no EVM alias
# and fails against every EVM tool and harness Tier 3.5.
#   Create:  https://portal.hedera.com     (choose ECDSA)
#   Fund:    https://portal.hedera.com/faucet
DEPLOYER_PRIVATE_KEY_ENCRYPTED=


# ---------------------------------------------------------------
# packages/nextjs/.env     — frontend
# ---------------------------------------------------------------

# WalletConnect / Reown project id. A built-in fallback works for
# local demos; set your own before deploying anywhere public.
#   https://cloud.reown.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# RPC overrides. Leave blank to use the public Hashio endpoints.
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=


# ---------------------------------------------------------------
# Shell environment only — harness Tier 3.5 chain validation.
# The harness does NOT read this file. Export these in your shell.
# ---------------------------------------------------------------
# HEDERA_OPERATOR_ID=0.0.xxxxxxx
# HEDERA_OPERATOR_KEY=0x...
