# ---------------------------------------------------------------
# Secrets — gate item G8. These rules exist BEFORE any file that
# could hold a key. Deleting a committed .env does not help: git
# keeps history, and bots scrape GitHub for Hedera keys in seconds.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.local
**/.env.*.local

# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------
# Yarn — the release binary and plugins MUST stay committed, or a
# freshly scaffolded project cannot install at all. Do not
# "simplify" this block to a bare .yarn/ ignore.
# ---------------------------------------------------------------
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# ---------------------------------------------------------------
# Harness runtime — recipe and validators ARE committed (G10),
# run artefacts are not.
# ---------------------------------------------------------------
.harness/runs/
.harness/runtime/
.harness/skills/
.skill-cache/

# ---------------------------------------------------------------
# MCP — dev-only tooling config. Never ship this in a template:
# the harness pins its own @playwright/mcp via npx and a committed
# config fights that pin on a judge's machine.
# ---------------------------------------------------------------
.mcp.json
.cursor/mcp.json

# ---------------------------------------------------------------
# Build artefacts
# ---------------------------------------------------------------
.next/
out/
build/
dist/
artifacts/
cache/
typechain-types/
coverage/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------
.eslintcache
.vercel

# ---------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------
.vscode
.idea
.DS_Store
Thumbs.db

# Design and logo working files. Process artefacts, not part of the template:
# a developer who scaffolds this should not receive 8MB of previews and zips.
/design-handoff/
.harness/spec.tier35.generated.yaml
packages/hardhat/.env.tier35-stash

# Process artefacts, not part of the template. A developer who scaffolds this
# should receive the product, not the notes we wrote while building it.
# Both still exist locally; they are simply not shipped.
/WALKTHROUGH.md
/HANDOVER.md

# Local demo production material. Keep app code, evidence-generation scripts,
# EVIDENCE.md, and harness validators in the shipped template.
/demo/
/bounty-demo/
/demo-script.*
/DEMO-SCRIPT.*
/demo-storyboard.*
/recordings/
/video-exports/

# Evidence run history. The two `latest-*.json` files ARE committed — they are
# the machine-readable proof behind EVIDENCE.md, and each carries a SHA-256 of
# every source file that produced it, so it cannot drift from the code without
# the mismatch showing. The per-run history under runs/ is process, not
# product, and one of those runs is an incomplete EVM attempt that would
# misrepresent what has actually been proven on-chain.
/evidence/runs/
