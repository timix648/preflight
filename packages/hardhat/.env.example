# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. From the repository root, run yarn hardhat:account:import.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Optional verifier network override; testnet is the default.
# HARDHAT_NETWORK=hederaTestnet

# Raw deployer and harness operator keys are runtime/shell-only.
# Never add __RUNTIME_DEPLOYER_PRIVATE_KEY or HEDERA_OPERATOR_KEY here.
