NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Optional server-side mirror origins, without /api/v1.
# Leave commented to use the defaults. Do not set these to empty strings.
# HEDERA_MIRROR_TESTNET_URL=https://testnet.mirrornode.hedera.com
# HEDERA_MIRROR_MAINNET_URL=https://mainnet.mirrornode.hedera.com

# Keep lint and TypeScript checks enabled during production builds.
NEXT_PUBLIC_IGNORE_BUILD_ERROR=false

# Optional framework settings; Vercel provides its production hostname.
# PORT=3000
# VERCEL_PROJECT_PRODUCTION_URL=your-project.vercel.app
